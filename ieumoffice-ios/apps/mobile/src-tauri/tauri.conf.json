{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AllEditor",
  "version": "1.0.0",
  "identifier": "com.mrnoh99.alleditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5185",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "IeumOffice",
        "width": 412,
        "height": 915,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
