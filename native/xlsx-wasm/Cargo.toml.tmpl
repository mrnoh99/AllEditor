[package]
name = "xlsx-wasm"
version = "0.1.0"
edition = "2024"
publish = false

[lib]
crate-type = ["cdylib"]

[dependencies]
xlsx-sidecar = { path = "@ENGINE@" }
# used by the engine's request loop (sidecar_main.rs)
serde = { version = "1", features = ["derive"] }
serde_json = "1"

[profile.release]
opt-level = "s"
lto = true
codegen-units = 1
strip = true
